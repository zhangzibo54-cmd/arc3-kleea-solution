+        action_handler: Callable[..., dict[str, Any]],
+        animation_handler: Callable[[dict[str, Any]], dict[str, Any]] | None,
+        timeout_seconds: int,
+        memory_limit_bytes: int = 2048 * 1024 * 1024,
+        cpu_limit_seconds: int = 300,
+        idle_limit_bytes: int = 0,
+    ) -> None:
