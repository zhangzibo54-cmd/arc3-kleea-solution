+    for k in range(1, (n - 1) // 2):
+        out.append((f"plus_small{k}", {(r, c) for r, c in cells
+                                       if (dist(r) == 0 and dist(c) <= k)
+                                       or (dist(c) == 0 and dist(r) <= k)}))
+        out.append((f"x_small{k}", {(r, c) for r, c in cells
+                                    if dist(r) == dist(c) and dist(r) <= k}))
